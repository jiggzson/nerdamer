{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"module": "node16",
		"moduleResolution": "node16",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"noImplicitAny": true,
		"rootDir": ".",
		"types": [
			"node",
			"jest"
		]
	},
	"include": [
		"src/**/*.ts",
		"spec/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"output",
		"docs",
		"generated"
	]
}