{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "commonjs",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"noEmit": true,
		"rootDir": ".",
		"types": ["node", "jest"]
	},
	"include": [
		"src/**/*.ts",
		"tools/**/*.ts",
		"spec/bigintUtils.spec.ts",
		"spec/stringUtils.spec.ts"
	],
	"exclude": ["node_modules", "dist", "output", "docs", "generated"]
}
