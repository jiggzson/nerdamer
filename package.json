{
	"name": "nerdamer",
	"version": "2.0.0-rc.2",
	"publishConfig": {
		"tag": "next"
	},
	"description": "A symbolic math library and computer algebra system for JavaScript and TypeScript.",
	"directory": {
		"lib": "./src"
	},
	"main": "dist/bundle.js",
	"types": "index.d.ts",
	"files": [
		"dist",
		"output",
		"docs-data",
		"index.d.ts",
		"README.md",
		"BREAKING_CHANGES.md",
		"docs/MIGRATING_FROM_1X.md",
		"docs/RELEASE_NOTES_2.md"
	],
	"scripts": {
		"lint": "eslint ./src/**/*.ts",
		"lint:fix": "eslint ./src/**/*.ts --fix",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage --runInBand",
		"build:types": "npm run clean:modules && tsc -p tsconfig.build.json",
		"build:modules": "npm run build:types",
		"build:bundle": "npm run clean:dist && webpack --mode=production --env target=full",
		"build:parser": "webpack --mode=production --env target=parser && node tools/smoke-build.cjs parser",
		"build:full": "npm run build:modules && npm run build:bundle && node tools/smoke-build.cjs full",
		"build": "npm run build:full",
		"docs:parser": "ts-node tools/generate-parser-docs.ts",
		"docs:check": "typedoc --options typedoc.json --emit none",
		"validate:package": "ts-node tools/validate-package.ts",
		"prepublishOnly": "npm run typecheck && npm run test && npm run test:coverage && npm run build && npm run build:parser && npm run docs:parser && npm run docs:check && npm run validate:package",
		"clean:modules": "node -e \"require('node:fs').rmSync('output', { recursive: true, force: true })\"",
		"clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiggzson/nerdamer.git"
	},
	"keywords": [
		"math",
		"mathematics",
		"algebra",
		"calculus",
		"symbolic",
		"symbolic math",
		"symbolic computation",
		"computer algebra",
		"computer algebra system",
		"cas",
		"parser",
		"expression parser",
		"equation solver",
		"solve",
		"simplify",
		"factorization",
		"polynomials",
		"derivative",
		"differentiation",
		"integral",
		"integration",
		"limits",
		"laplace transform",
		"linear algebra",
		"matrix",
		"vectors",
		"complex numbers",
		"numeric",
		"javascript",
		"typescript"
	],
	"author": "Martin Donk",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/jiggzson/nerdamer/issues"
	},
	"homepage": "https://nerdamer.com",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"decimal.js": "^10.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@types/eslint__js": "^8.42.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.10",
		"eslint": "^9.39.3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-perfectionist": "^5.6.0",
		"html-webpack-plugin": "^5.6.4",
		"jest": "^30.2.0",
		"prettier": "^3.8.1",
		"terser-webpack-plugin": "^5.3.14",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"webpack": "^5.111.1",
		"webpack-cli": "^7.2.3"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"require": "./dist/bundle.js",
			"default": "./dist/bundle.js"
		},
		"./core": {
			"types": "./output/api/core.d.ts",
			"require": "./output/api/core.js",
			"default": "./output/api/core.js"
		},
		"./algebra": {
			"types": "./output/api/algebra.d.ts",
			"require": "./output/api/algebra.js",
			"default": "./output/api/algebra.js"
		},
		"./calculus": {
			"types": "./output/api/calculus.d.ts",
			"require": "./output/api/calculus.js",
			"default": "./output/api/calculus.js"
		},
		"./solve": {
			"types": "./output/api/solve.d.ts",
			"require": "./output/api/solve.js",
			"default": "./output/api/solve.js"
		},
		"./structures": {
			"types": "./output/api/structures.d.ts",
			"require": "./output/api/structures.js",
			"default": "./output/api/structures.js"
		},
		"./assumptions": {
			"types": "./output/api/assumptions.d.ts",
			"require": "./output/api/assumptions.js",
			"default": "./output/api/assumptions.js"
		},
		"./parser": {
			"types": "./output/api/parser.d.ts",
			"require": "./output/api/parser.js",
			"default": "./output/api/parser.js"
		},
		"./advanced": {
			"types": "./output/api/advanced.d.ts",
			"require": "./output/api/advanced.js",
			"default": "./output/api/advanced.js"
		},
		"./debug": {
			"types": "./output/api/debug.d.ts",
			"require": "./output/api/debug.js",
			"default": "./output/api/debug.js"
		},
		"./docs-data/parser-functions.json": "./docs-data/parser-functions.json",
		"./dist/bundle.js": "./dist/bundle.js",
		"./dist/parser.js": "./dist/parser.js",
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"core": ["output/api/core.d.ts"],
			"algebra": ["output/api/algebra.d.ts"],
			"calculus": ["output/api/calculus.d.ts"],
			"solve": ["output/api/solve.d.ts"],
			"structures": ["output/api/structures.d.ts"],
			"assumptions": ["output/api/assumptions.d.ts"],
			"parser": ["output/api/parser.d.ts"],
			"advanced": ["output/api/advanced.d.ts"],
			"debug": ["output/api/debug.d.ts"]
		}
	}
}
