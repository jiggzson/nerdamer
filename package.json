{
	"name": "nerdamer",
	"version": "2.0.0",
	"description": "A symbolic math library and computer algebra system for JavaScript and TypeScript.",
	"directory": {
		"lib": "./src"
	},
	"main": "dist/bundle.js",
	"types": "output/index.d.ts",
	"typings": "output/index.d.ts",
	"files": [
		"dist",
		"output",
		"README.md"
	],
	"scripts": {
		"dev": "nodemon ./tools/dev.ts",
		"lint": "eslint ./src/**/*.ts",
		"lint:fix": "eslint ./src/**/*.ts --fix",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "jest",
		"test:dump": "npm test -- --json --outputFile=test-results.json --testFailureExitCode=1 --testNamePattern=\"^(?!.*\\[slow\\])\"",
		"test:all": "npm test -- --json --outputFile=test-results.json --testFailureExitCode=1",
		"build:types": "tsc -p tsconfig.build.json",
		"build": "npm run build:types && webpack --mode=production --node-env=production",
		"build:dev": "webpack --mode=development",
		"build:prod": "npm run build",
		"watch": "webpack --watch",
		"serve": "webpack serve",
		"docs": "npx typedoc src/index.ts --out docs/api",
		"docs:api": "typedoc src/index.ts src/typedoc.entry.ts --json generated/typedoc/typedoc.json",
		"docs:all": "npm run docs:api && npm run docs:html",
		"docs:html": "typedoc src/index.ts src/typedoc.entry.ts --plugin typedoc-material-theme --themeColor '#e63420' --out docs/html",
		"prepublishOnly": "npm run test && npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jiggzson/nerdamer.git"
	},
	"keywords": [
		"math",
		"mathematics",
		"algebra",
		"calculus",
		"symbolic",
		"symbolic math",
		"symbolic computation",
		"computer algebra",
		"computer algebra system",
		"cas",
		"parser",
		"expression parser",
		"equation solver",
		"solve",
		"simplify",
		"factorization",
		"polynomials",
		"derivative",
		"differentiation",
		"integral",
		"integration",
		"limits",
		"laplace transform",
		"linear algebra",
		"matrix",
		"vectors",
		"complex numbers",
		"numeric",
		"javascript",
		"typescript"
	],
	"author": "Martin Donk",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/jiggzson/nerdamer/issues"
	},
	"homepage": "http://nerdamer.com",
	"dependencies": {
		"decimal.js": "^10.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.8.0",
		"@types/eslint__js": "^8.42.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.10",
		"@webpack-cli/generators": "^2.4.2",
		"css-loader": "^7.1.2",
		"eslint": "^9.39.3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-perfectionist": "^5.6.0",
		"html-webpack-plugin": "^5.6.3",
		"jasmine": "^5.1.0",
		"jest": "^30.2.0",
		"mini-css-extract-plugin": "^2.9.2",
		"nodemon": "^3.1.4",
		"prettier": "^3.8.1",
		"sass": "^1.86.0",
		"sass-loader": "^16.0.5",
		"style-loader": "^4.0.0",
		"terser-webpack-plugin": "^5.3.14",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.17",
		"typedoc-material-theme": "^1.4.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.0.0",
		"webpack": "^5.98.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.2.0",
		"workbox-webpack-plugin": "^7.0.0"
	}
}